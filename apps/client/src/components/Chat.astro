<script>
  let ws: WebSocket | null = null;
  let currentUser = "";

  const loginDiv = document.getElementById("login")!;
  const chatDiv = document.getElementById("chat")!;
  const messagesDiv = document.getElementById("messages")!;
  const userIdInput = document.getElementById("userId") as HTMLInputElement;
  const chatIdInput = document.getElementById("chatId") as HTMLInputElement;
  const messageInput = document.getElementById(
    "messageInput",
  ) as HTMLInputElement;

  document.getElementById("joinBtn")!.addEventListener("click", joinChat);
  document.getElementById("sendBtn")!.addEventListener("click", sendMessage);
  messageInput.addEventListener("keypress", (e) => {
    if (e.key === "Enter") sendMessage();
  });

  function joinChat() {
    const userId = userIdInput.value.trim();
    const chatId = chatIdInput.value.trim();
    if (!userId || !chatId) return;

    currentUser = userId;
    ws = new WebSocket(`ws://${window.location.hostname}:4000/chat`);

    ws.onopen = () => {
      ws!.send(JSON.stringify({ type: "join", data: { userId, chatId } }));
      loginDiv.style.display = "none";
      chatDiv.style.display = "block";
    };

    ws.onmessage = (e) => {
      const msg = JSON.parse(e.data);
      switch (msg.type) {
        case "message":
          appendMsg(`<strong>${msg.data.from}:</strong> ${msg.data.text}`);
          break;
        case "user_joined":
          appendMsg(`<em>${msg.userId} joined</em>`);
          break;
        case "user_left":
          appendMsg(`<em>${msg.userId} left</em>`);
          break;
        case "error":
          appendMsg(`<span style="color:red">${msg.message}</span>`);
          break;
      }
    };

    ws.onclose = () => {
      appendMsg("<em>Disconnected</em>");
    };
  }

  function sendMessage() {
    const text = messageInput.value.trim();
    if (!text || !ws) return;

    ws.send(
      JSON.stringify({
        type: "message",
        data: { from: currentUser, text },
      }),
    );
    messageInput.value = "";
  }

  function appendMsg(html: string) {
    const p = document.createElement("p");
    p.innerHTML = html;
    messagesDiv.appendChild(p);
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
  }
</script>

<div id="chat-app">
  <div id="login">
    <input id="userId" placeholder="Username" />
    <input id="chatId" placeholder="Chat Room" />
    <button id="joinBtn">Join</button>
  </div>
  <div id="chat" style="display:none;">
    <div id="messages"></div>
    <div id="input-area">
      <input id="messageInput" placeholder="Type a message..." />
      <button id="sendBtn">Send</button>
    </div>
  </div>
</div>

<style>
  #chat-app {
    max-width: 600px;
    margin: 2rem auto;
    padding: 1rem;
    font-family: sans-serif;
  }
  #login,
  #input-area {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  input {
    flex: 1;
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  button {
    padding: 0.5rem 1rem;
    background: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  button:hover {
    background: #0056b3;
  }
  #messages {
    height: 400px;
    overflow-y: auto;
    border: 1px solid #eee;
    padding: 1rem;
    margin-bottom: 1rem;
    background: #f9f9f9;
  }
  #messages p {
    margin: 0.25rem 0;
  }
</style>
